# Copiá este archivo como .env y completá los valores reales.
# Nunca subas el .env a GitHub ni lo compartas.

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=alertas_marcas
PGUSER=alertas
PGPASSWORD=
# Poner true si la base está en un servicio en la nube que exige SSL
PGSSL=false
PGPOOL_MAX=10

# Motor de alertas: similitud ortográfica mínima (0 a 1)
UMBRAL_SIMILITUD=0.4
# Mínimo para detectar el término dentro de una marca más larga (0 a 1)
UMBRAL_PALABRA=0.5

# Página donde la DINAPI publica los boletines semanales (CSV + PDF).
# Vacío = la página oficial de boletines de marcas.
BOLETINES_PAGINA_URL=
# Máximo de boletines nuevos a cargar por corrida
BOLETINES_MAXIMO_POR_CORRIDA=5
# Codificación del CSV: utf-8 o latin1 (muchos portales del gobierno usan latin1)
BOLETIN_ENCODING=utf-8

# Avisos por email. AVISOS_MODO puede ser:
#   prueba = no envía nada, guarda cada email en logs/avisos/ para revisarlo
#   brevo  = envía con Brevo (completar BREVO_API_KEY)
#   smtp   = cualquier otro servidor de correo (completar SMTP_...)
AVISOS_MODO=prueba
# El remitente tiene que estar verificado en Brevo (Senders, Domains & Dedicated IPs)
AVISOS_REMITENTE="Alertas de Marcas <avisos@tu-dominio.com.py>"
# Clave de API de Brevo (empieza con xkeysib-). Solo acá, nunca en el código ni en mensajes.
BREVO_API_KEY=
# Solo para modo smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Página web para clientes (npm start)
PORT=3100
# 127.0.0.1 = solo accesible desde el mismo servidor (detrás de Cloudflare Tunnel o nginx).
# 0.0.0.0 = accesible desde la red.
HOST=127.0.0.1
# true si se publica detrás de Cloudflare Tunnel o nginx (para detectar HTTPS y la IP real)
TRUST_PROXY=false
# Marcas que puede vigilar un usuario FREE (PREMIUM no tiene límite)
PLAN_FREE_MAXIMO=3

# Carpeta donde se guardan los registros de errores
LOG_DIR=./logs
